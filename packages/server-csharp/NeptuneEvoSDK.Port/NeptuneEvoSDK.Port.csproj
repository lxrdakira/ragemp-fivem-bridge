<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NeptuneEvoSDK.Port</AssemblyName>
    <RootNamespace>NeptuneEvo</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RageMP.FiveM.Bridge.Core\RageMP.FiveM.Bridge.Core.csproj" />
    <PackageReference Include="MySqlConnector" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.110" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\dotnet\resources\NeptuneEvoSDK\**\*.cs"
             Exclude="..\..\..\..\dotnet\resources\NeptuneEvoSDK\bin\**;..\..\..\..\dotnet\resources\NeptuneEvoSDK\obj\**"
             Link="NeptuneEvoSDK\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
