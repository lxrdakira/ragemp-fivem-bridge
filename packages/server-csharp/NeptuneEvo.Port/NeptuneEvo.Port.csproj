<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NeptuneEvo.Port.net</AssemblyName>
    <RootNamespace>NeptuneEvo</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RageMP.FiveM.Bridge.Core\RageMP.FiveM.Bridge.Core.csproj" />
    <ProjectReference Include="..\NeptuneEvoSDK.Port\NeptuneEvoSDK.Port.csproj" />
    <ProjectReference Include="..\Localization.Port\Localization.Port.csproj" />
    <ProjectReference Include="..\..\..\..\YoutubeExplode-master\YoutubeExplode\YoutubeExplode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="linq2db.MySql" Version="3.3.0" />
    <PackageReference Include="MySql.Data" Version="8.0.28" />
    <PackageReference Include="MySqlBackup.NET" Version="2.3.4" />
    <PackageReference Include="MySqlConnector" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="AWSSDK.S3" Version="3.3.113.2" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Otp.NET" Version="1.2.2" />
    <PackageReference Include="StackExchange.Redis" Version="2.2.79" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.113.7" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Compatibility.cs" />
    <Compile Include="FiveMCompatibilityEvents.cs" />
    <Compile Include="FiveMIdentityBridge.cs" />
    <Compile Include="StagingIsolation.cs" />
    <Compile Include="RedisConnection.cs" />
    <Compile Include="LegacyNpcClothing.cs" />
  </ItemGroup>

  <Target Name="GenerateFiveMPortSources" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <NeptuneSourceRoot>$(MSBuildProjectDirectory)\..\..\..\..\dotnet\resources\NeptuneEvo</NeptuneSourceRoot>
      <NeptuneGeneratedRoot>$(IntermediateOutputPath)PortedSources</NeptuneGeneratedRoot>
    </PropertyGroup>
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\generate-ported-sources.mjs&quot; &quot;$(NeptuneSourceRoot)&quot; &quot;$(NeptuneGeneratedRoot)&quot;" />
    <ItemGroup>
      <Compile Include="$(NeptuneGeneratedRoot)\**\*.cs" />
    </ItemGroup>
  </Target>
</Project>
