<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Localization.Port</AssemblyName>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\dotnet\resources\Localization\**\*.cs"
             Exclude="..\..\..\..\dotnet\resources\Localization\bin\**;..\..\..\..\dotnet\resources\Localization\obj\**"
             Link="Localization\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
